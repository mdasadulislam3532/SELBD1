<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="প্রক্সি ফরম্যাট (IP:Port অথবা IP:Port:User:Pass):"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProxyFull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="যেমন: 198.51.100.1:8080"
        android:inputType="textUri"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnCheckLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="লাইভ লোকেশন ও আইপি চেক করুন" />

    <TextView
        android:id="@+id/tvLocationResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="আইপি স্ট্যাটাস: চেক করা হয়নি"
        android:textColor="#0D65D9"
        android:textSize="13sp" />

</LinearLayout>
